# Patient data: never commit
*.xlsx
*.xls
*.csv
*.tsv
*.pkl
*.parquet
data/raw/
data/processed/
data/private/

# Synthetic data: generated by us, never real, but generated cohorts are large and
# fully reproducible from a fixed seed, so they stay untracked. The one exception is
# the small committed sample that lets a reader see the schema without running code.
!data/synthetic/sample/*.csv

# Secrets / local config
.env
.env.*
!.env.example

# Python / Jupyter / uv
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# macOS
.DS_Store
