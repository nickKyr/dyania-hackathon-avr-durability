# Patient data: never commit.
# The repository and the fork may be public, and a leak is irreversible once pushed.
*.xlsx
*.xls
*.csv
*.tsv
*.pkl
*.parquet
data/raw/
data/processed/
data/private/

# Intermediate build products of the extraction scripts (see scripts/README.md).
data/llm_json/
data/raw_tables/
data/**/*.parquet
data/**/*.csv
data/**/*.json

# Synthetic data: generated by us, never real. Generated cohorts are large and fully
# reproducible from a fixed seed, so they stay untracked. The one exception is the
# small committed sample that lets a reader see the schema without running code.
# This rule must stay BELOW the patterns above, because the last match wins.
!data/synthetic/sample/*.csv

# Secrets / local config
.env
.env.*
!.env.example
meeting_notes*.txt

# Python / Jupyter / uv
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store
